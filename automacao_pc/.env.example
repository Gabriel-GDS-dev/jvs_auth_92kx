LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=sua_livekit_api_key
LIVEKIT_API_SECRET=seu_livekit_api_secret
AGENT_NAME=

GEMINI_API_KEY=sua_gemini_api_key
GOOGLE_REALTIME_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GOOGLE_REALTIME_VOICE=Charon
GOOGLE_REALTIME_API_VERSION=v1alpha
GOOGLE_REALTIME_TIMEOUT=60
GOOGLE_REALTIME_MAX_RETRIES=4
GOOGLE_REALTIME_TRANSCRIPTION_ENABLED=false
GEMINI_VISION_MODEL=gemini-2.5-flash
MEM0_MEMORY_LIMIT=8
MEM0_SAVE_LIMIT=20

MEM0_API_KEY=sua_mem0_api_key

# OneDrive / Microsoft Graph
ONEDRIVE_CLIENT_ID=
ONEDRIVE_TENANT_ID=consumers
ONEDRIVE_SCOPES=Files.ReadWrite.All User.Read
ONEDRIVE_AUTH_FLOW=device_code
ONEDRIVE_REDIRECT_PORT=8080
ONEDRIVE_REDIRECT_URI=http://localhost:8080
ONEDRIVE_TOKEN_CACHE=onedrive_token_cache.bin
ONEDRIVE_OPEN_BROWSER=true

# Ligue para o Jarvis receber camera ou compartilhamento de tela pelo LiveKit.
JARVIS_VIDEO_ENABLED=true

# Obsidian
OBSIDIAN_VAULT_PATH=
OBSIDIAN_VAULT_NAME=

# Notion API opcional. Sem isso, o Jarvis abre o Notion e digita pela tela.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
NOTION_URL=https://www.notion.so

# Opcional: onde salvar screenshots e arquivos temporarios.
JARVIS_RUNTIME_DIR=
