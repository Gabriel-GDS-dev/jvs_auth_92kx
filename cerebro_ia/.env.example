LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=sua_livekit_api_key
LIVEKIT_API_SECRET=seu_livekit_api_secret

# Gemini API: gere uma chave no Google AI Studio.
GEMINI_API_KEY=sua_gemini_api_key

# Legado: nao defina GOOGLE_API_KEY junto com GEMINI_API_KEY.
# O Jarvis normaliza internamente para GEMINI_API_KEY e remove GOOGLE_API_KEY do processo.
# GOOGLE_API_KEY=

# Opcional: para usar Vertex AI em vez de chave Gemini.
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=seu-projeto
# GOOGLE_CLOUD_LOCATION=us-central1

MEM0_API_KEY=sua_mem0_api_key

# Spotify Web API / Spotify Connect
# Crie um app em https://developer.spotify.com/dashboard e cadastre este Redirect URI:
# http://127.0.0.1:8888/callback
# Com SPOTIFY_AUTH_FLOW=pkce, basta preencher SPOTIFY_CLIENT_ID.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_AUTH_FLOW=pkce
SPOTIFY_MARKET=BR
SPOTIFY_SCOPES=user-read-playback-state user-read-currently-playing user-modify-playback-state user-read-private playlist-read-private
SPOTIFY_TOKEN_CACHE=cache/spotify_token_cache.json
# Opcional: preencha apenas se trocar SPOTIFY_AUTH_FLOW=authorization_code.
SPOTIFY_CLIENT_SECRET=
# Opcional: fixe um dispositivo depois de rodar spotify_dispositivos.
SPOTIFY_DEVICE_ID=

# OneDrive / Microsoft Graph
ONEDRIVE_CLIENT_ID=
ONEDRIVE_TENANT_ID=consumers
ONEDRIVE_SCOPES=Files.ReadWrite.All User.Read
ONEDRIVE_AUTH_FLOW=device_code
ONEDRIVE_REDIRECT_PORT=8080
ONEDRIVE_REDIRECT_URI=http://localhost:8080
ONEDRIVE_TOKEN_CACHE=onedrive_token_cache.bin
ONEDRIVE_OPEN_BROWSER=true

# Opcional
GOOGLE_REALTIME_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GOOGLE_REALTIME_VOICE=Charon
GOOGLE_REALTIME_API_VERSION=v1alpha
GOOGLE_REALTIME_TIMEOUT=60
GOOGLE_REALTIME_MAX_RETRIES=4
GOOGLE_REALTIME_TRANSCRIPTION_ENABLED=false
GEMINI_VISION_MODEL=gemini-2.5-flash
MEM0_MEMORY_LIMIT=8
MEM0_SAVE_LIMIT=20

# Ligue para o Jarvis receber camera ou compartilhamento de tela pelo LiveKit.
JARVIS_VIDEO_ENABLED=false
JARVIS_VIDEO_MAX_FPS=1
JARVIS_VIDEO_SILENT_FPS=0.2
JARVIS_VIDEO_MAX_WIDTH=960
JARVIS_VIDEO_JPEG_QUALITY=65
JARVIS_VIDEO_QUEUE_SIZE=1
JARVIS_MAX_TOOL_STEPS=6

# Multi-IA / integracoes avancadas
GROQ_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
JINA_API_KEY=
COHERE_API_KEY=
CARTESIA_API_KEY=
OCRSPACE_API_KEY=
SEARXNG_URL=
WHATSAPP_SERVICE_URL=http://127.0.0.1:3333

# Google Calendar opcional.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Sao_Paulo
# Se nao preencher, o codigo procura google_calendar_credentials.json nesta pasta.
GOOGLE_CALENDAR_CREDENTIALS_FILE=
# Se nao preencher, o codigo cria google_calendar_token.json nesta pasta.
GOOGLE_CALENDAR_TOKEN_FILE=
# Opcional para conta de servico, se preferir esse fluxo.
GOOGLE_CALENDAR_SERVICE_ACCOUNT_FILE=
